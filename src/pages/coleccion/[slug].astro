---
import ArrowUpRight from '../../components/ui/ArrowUpRight.astro';
import { withBase } from '../../utils/paths.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchoolGallery from '../../components/catalog/SchoolGallery.astro';
import { getPublishedUniforms } from '../../data/uniforms.js';
import { getWhatsappLink } from '../../data/site.js';
export function getStaticPaths() {
  return getPublishedUniforms().map((uniform) => ({ params: { slug: uniform.slug }, props: { uniform } }));
}
const { uniform } = Astro.props;
---
<BaseLayout title={uniform.name} description={uniform.description || undefined}>
  <section class="container-site section-pad">
    <a href={withBase('/coleccion')} class="eyebrow hover:text-gold">← Colección por colegios</a>
    <div class="my-10 md:my-14 max-w-3xl">
      <p class="eyebrow mb-4">{uniform.category}</p>
      <h1 class="text-3xl md:text-5xl">{uniform.name}</h1>
      {uniform.description && <p class="mt-5 text-carbon/70 leading-relaxed">{uniform.description}</p>}
    </div>
    <SchoolGallery images={uniform.images} name={uniform.name} />
    <div class="mt-14 border-t border-line pt-10 grid gap-10 md:grid-cols-2">
      <dl class="space-y-6 text-sm">
        <div><dt class="eyebrow mb-2">Colores</dt><dd>{uniform.colors.join(' · ')}</dd></div>
        <div><dt class="eyebrow mb-2">Tallas</dt><dd>{uniform.sizes.join('-')}</dd></div>
      </dl>
      <div>
        <h2 class="text-2xl">Encuentra tu talla.</h2>
        <p class="mt-3 text-carbon/70 leading-relaxed">Consulta las tallas y la disponibilidad de las prendas. Te acompañamos en tu elección.</p>
        <a href={getWhatsappLink(`Hola, quisiera información sobre los uniformes de ${uniform.name}. ¿Qué tallas tienen disponibles?`)} target="_blank" rel="noopener noreferrer" class="btn-primary mt-6">Consultar esta colección <ArrowUpRight /></a>
      </div>
    </div>
  </section>
</BaseLayout>
