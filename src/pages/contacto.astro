---
import ArrowUpRight from '../components/ui/ArrowUpRight.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteInfo, getWhatsappLink } from '../data/site.js';

const mapUrl = 'https://www.google.com/maps/place/Confecciones+y+Bordados+%22Tomalito%22/@-0.2516637,-78.5163416,21z/data=!4m15!1m8!3m7!1s0x91d598540d4ddf75:0xb00e1ae029f29c7f!2sLa+Ferroviaria,+Quito!3b1!8m2!3d-0.2575728!4d-78.5164078!16s%2Fg%2F1tf7ysy_!3m5!1s0x91d599ed81844789:0x24ee8263e57ba93a!8m2!3d-0.2517009!4d-78.5163046!16s%2Fg%2F11njyr4xz9?entry=ttu&g_ep=EgoyMDI2MDkwMi4wIKXMDSoASAFQAw%3D%3D';

const phoneNumbers = [
  { display: '098 412 3428', link: '+593984123428' },
  { display: '099 559 6363', link: '+593995596363' },
];
---

<BaseLayout
  title="Contacto"
  description="Comunícate con Tomalito o visita nuestro local en La Ferroviaria, Quito."
>
  <div class="container-site section-pad">
    <div class="mb-12 max-w-2xl">
      <p class="mb-3 text-sm font-medium uppercase tracking-[0.2em] text-gold">Estamos para ayudarte</p>
      <h1 class="text-3xl md:text-5xl">Contacto</h1>
      <p class="mt-4 leading-relaxed text-carbon/70">
        Escríbenos, llámanos o visítanos para conversar sobre el uniforme que necesitas.
      </p>
    </div>

    <div class="grid items-stretch gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:gap-14">
      <section class="border border-line bg-white/30 p-7 md:p-9" aria-labelledby="contact-details">
        <h2 id="contact-details" class="mb-8 text-2xl">Información de contacto</h2>

        <div class="space-y-8">
          <div>
            <p class="mb-2 text-xs font-medium uppercase tracking-[0.18em] text-gold">Teléfonos</p>
            <div class="flex flex-col items-start gap-2">
              {phoneNumbers.map((phone) => (
                <a
                  class="inline-flex min-h-11 flex-wrap items-center gap-x-3 gap-y-1 py-2 text-carbon-dark hover:text-gold"
                  href={`tel:${phone.link}`}
                  aria-label={`Llamar al ${phone.display}`}
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.4 1.8.6 2.8.7a2 2 0 0 1 1.8 2.1Z" /></svg>
                  <span class="text-lg">{phone.display}</span>
                  <span class="text-xs underline underline-offset-4"></span>
                </a>
              ))}
            </div>
          </div>

          <div>
            <p class="mb-2 text-xs font-medium uppercase tracking-[0.18em] text-gold">Ubicación</p>
            <p class="leading-relaxed text-carbon/80">La Ferroviaria, Quito, Ecuador</p>
            <a
              href={mapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 inline-flex items-center gap-2 text-sm text-carbon-dark underline decoration-gold underline-offset-4 hover:text-gold"
            >
              Ver ubicación en Google Maps
              <span aria-hidden="true"><ArrowUpRight /></span>
            </a>
          </div>

          <div>
            <p class="mb-3 text-xs font-medium uppercase tracking-[0.18em] text-gold">WhatsApp</p>
            <a href={getWhatsappLink()} target="_blank" rel="noopener noreferrer" class="btn-primary">
              Escríbenos por WhatsApp
            </a>
          </div>
        </div>
      </section>

      <section aria-labelledby="location-title">
        <h2 id="location-title" class="sr-only">Ubicación de Tomalito</h2>
        <div class="h-full min-h-[380px] overflow-hidden border border-line bg-line md:min-h-[480px]">
          <iframe
            src="https://www.google.com/maps?q=-0.2517009,-78.5163046&z=18&output=embed"
            title="Ubicación de Confecciones y Bordados Tomalito"
            class="h-full min-h-[380px] w-full md:min-h-[480px]"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </section>
    
  </div>
</BaseLayout>
