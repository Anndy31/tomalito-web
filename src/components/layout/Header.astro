---
import ArrowUpRight from '../ui/ArrowUpRight.astro';
import { withBase } from '../../utils/paths.js';
import { uniforms } from '../../data/uniforms.js';
const isCurrent = (path: string) => Astro.url.pathname.replace(/\/$/, '') === withBase(path).replace(/\/$/, '');
---
<header class="border-b border-line bg-white sticky top-0 z-40">
  <div class="container-site grid grid-cols-[1fr_auto_1fr] items-center h-[72px] sm:h-24 gap-2 sm:gap-3">
    <button id="menu-toggle" type="button" aria-controls="navigation-panel" aria-expanded="false" aria-haspopup="dialog" class="justify-self-start flex items-center gap-3 min-h-12 text-xs uppercase tracking-widest">
      <svg width="24" height="18" viewBox="0 0 24 18" fill="none" stroke="currentColor" aria-hidden="true"><path d="M0 3h24M0 9h24M0 15h24"/></svg>
      Menú
    </button>
    <a href={withBase('/')} aria-label="Tomalito, inicio" class="justify-self-center"><img src={withBase('/images/brand/Logo.png')} alt="Tomalito" class="h-12 sm:h-14 md:h-16 w-auto max-w-[120px] sm:max-w-none object-contain" /></a>
    <a href={withBase('/contacto')} class="justify-self-end text-xs uppercase tracking-widest flex items-center gap-2 min-h-12" aria-label="Contacto">
      <span class="hidden sm:inline">Contacto</span>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 6 9 7 9-7"/></svg>
    </a>
  </div>
</header>

<dialog id="navigation-panel" aria-label="Menú principal de Tomalito" class="navigation-panel">
  <div class="drawer-layout">
    <div class="drawer-content">
      <div class="flex items-center justify-between border-b border-line pb-6 mb-8">
        <p class="text-xs uppercase tracking-[0.25em]">Tomalito</p>
        <button type="button" id="menu-close" class="flex items-center gap-3 p-3 text-xs uppercase tracking-widest" aria-label="Cerrar menú">Cerrar <span class="text-2xl" aria-hidden="true">×</span></button>
      </div>
      <nav aria-label="Navegación principal" class="drawer-nav">
        <a href={withBase('/')} aria-current={isCurrent('/') ? 'page' : undefined}>Inicio <span aria-hidden="true"><ArrowUpRight /></span></a>
        <details>
          <summary>Colección por colegios <span aria-hidden="true">+</span></summary>
          <div class="sub-links">
            <a href={withBase('/coleccion')} aria-current={isCurrent('/coleccion') ? 'page' : undefined}>Ver todos los colegios <ArrowUpRight /></a>
            {uniforms.map((school) => <a href={withBase(`/coleccion/${school.slug}`)} aria-current={isCurrent(`/coleccion/${school.slug}`) ? 'page' : undefined}>{school.name}</a>)}
          </div>
        </details>
        <details>
          <summary>Servicios <span aria-hidden="true">+</span></summary>
          <div class="sub-links">
            <a href={withBase('/servicios')} aria-current={isCurrent('/servicios') ? 'page' : undefined}>Todos los servicios <ArrowUpRight /></a>
            <a href={withBase('/servicios#fabricacion')}>Fabricación</a>
            <a href={withBase('/servicios#bordado')}>Bordado</a>
            <a href={withBase('/servicios#enfermeria')}>Uniformes de enfermería</a>
            <a href={withBase('/servicios#produccion-corporativa')}>Producción corporativa</a>
            <a href={withBase('/servicios#vinil-textil')}>Vinil textil</a>
          </div>
        </details>
        <a href={withBase('/nosotros')} aria-current={isCurrent('/nosotros') ? 'page' : undefined}>Nosotros <span aria-hidden="true"><ArrowUpRight /></span></a>
        <a href={withBase('/contacto')} aria-current={isCurrent('/contacto') ? 'page' : undefined}>Contacto <span aria-hidden="true"><ArrowUpRight /></span></a>
      </nav>
      <div class="mt-12 pt-7 border-t border-line">
        <p class="text-xs text-carbon/60">Confecciones y bordados · Quito, Ecuador</p>
      </div>
    </div>
  </div>
</dialog>

<style>
.navigation-panel { position: fixed; inset: 0 auto 0 0; margin: 0; padding: 0; width: min(480px, 90vw); max-width: 100vw; height: 100dvh; max-height: 100dvh; border: 0; background: white; color: #292929; }
.navigation-panel::backdrop { background: rgb(0 0 0 / 40%); backdrop-filter: blur(3px); }
.navigation-panel[open] { animation: slide-in .28s ease-out; }
.drawer-layout { min-height: 100%; }
.drawer-content { padding: 24px 36px 40px; }
.drawer-nav > a, .drawer-nav summary { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 19px 0; font-size: 22px; cursor: pointer; list-style: none; }
.drawer-nav summary::-webkit-details-marker { display: none; }
.drawer-nav > a:hover, .drawer-nav summary:hover { color: #666; }
.drawer-nav summary span { transition: transform .2s; }
.drawer-nav details[open] summary span { transform: rotate(45deg); }
.sub-links { display: grid; gap: 0; padding: 0 0 16px 16px; border-left: 1px solid #ddd; margin-bottom: 8px; }
.sub-links a { display: block; padding: 12px 0; font-size: 13px; line-height: 1.5; }
.sub-links a:hover { text-decoration: underline; text-underline-offset: 4px; }
.drawer-nav a[aria-current="page"] { font-weight: 500; text-decoration: underline; text-underline-offset: 5px; }
@keyframes slide-in { from { transform: translateX(-100%); } to { transform: translateX(0); } }
@media (max-width: 767px) {
  .navigation-panel { width: 100%; overscroll-behavior: contain; }
  .drawer-content { padding: max(16px, env(safe-area-inset-top)) 20px max(32px, env(safe-area-inset-bottom)); }
  .drawer-nav > a, .drawer-nav summary { font-size: 20px; padding: 16px 0; }
  .sub-links a { min-height: 44px; font-size: 14px; }
}
</style>

<script>
const trigger = document.querySelector<HTMLButtonElement>('#menu-toggle')!;
const panel = document.querySelector<HTMLDialogElement>('#navigation-panel')!;
const closeButton = document.querySelector<HTMLButtonElement>('#menu-close')!;
let originalOverflow = '';
const openMenu = () => {
  if (panel.open) return;
  originalOverflow = document.body.style.overflow;
  document.body.style.overflow = 'hidden';
  panel.showModal();
  trigger.setAttribute('aria-expanded', 'true');
};
trigger.addEventListener('click', openMenu);
closeButton.addEventListener('click', () => panel.close());
panel.addEventListener('close', () => {
  document.body.style.overflow = originalOverflow;
  trigger.setAttribute('aria-expanded', 'false');
  trigger.focus({ preventScroll: true });
});
panel.addEventListener('click', (event) => {
  const bounds = panel.getBoundingClientRect();
  if (event.target === panel && (event.clientX > bounds.right || event.clientX < bounds.left)) panel.close();
  if ((event.target as Element).closest('a')) panel.close();
});
</script>
